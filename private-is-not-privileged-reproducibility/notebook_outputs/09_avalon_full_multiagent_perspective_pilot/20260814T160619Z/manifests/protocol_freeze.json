{
  "full_games": 8,
  "players_per_game": 5,
  "all_players_machine_controlled": true,
  "shared_weights_separate_logical_agents": true,
  "role_and_fold_fixed_before_outcomes": true,
  "target": "naturally occurring Evil player mission action on an approved team",
  "labels": {
    "PASS": 0,
    "SABOTAGE": 1
