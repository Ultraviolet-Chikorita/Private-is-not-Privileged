    "mission_aggregate_fail_count_public": true,
    "own_hidden_actions_private_memory": true
  },
  "h1_gate": {
    "all_player_mission_validity_min": 0.95,
    "target_validity_min": 0.95,
    "auditor_validity_min": 0.95,
    "minimum_games_with_valid_targets": 4,
    "minimum_count_each_action": 4
  },
  "bootstrap_reps": 10000,
  "no_post_outcome_target_redefinition": true
